# Semantic Programming Language
# Native readable projection sample
se 1
program {
    schema = 1

    types {
        type @1 {
            kind = integer
            origin = builtin
        }
        type @2 {
            kind = function
            origin = semantic
        }
    }

    scopes {
        scope %1 {
            kind = function
            parent = %0
        }
    }

    nodes {
        node %10 {
            structural_kind = function
            kind = declaration
            scope = %1
            facet = [ callable pure ]
        }

        node %11 {
            structural_kind = return
            kind = statement
            scope = %1
        }
    }

    relations {
        contains %10 -> node:11 {
            ordinal = 0
            role = body
        }
    }

    language_facet = ranges 32 [ 0-3 8 10-12 ]
}
